# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.
ADMIN_PASSWORD=change-me
# 32+ random bytes, hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Local: file:./data/joule.db   Production: libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL=file:./data/joule.db
TURSO_AUTH_TOKEN=
